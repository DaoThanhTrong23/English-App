  READ_STUDENT_PROGRESS
  READ_STUDENT_AI_CHAT
  UPDATE_STUDENT_STATUS

  // === ADMIN - WORD ===
  READ_WORD_LIST
  READ_WORD_COUNT
  READ_WORD_DETAIL
  CREATE_WORD
  UPDATE_WORD
  DELETE_WORD
  CREATE_WORD_BULK
