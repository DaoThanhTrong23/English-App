  UPDATE_NOTIFICATION_READ_ALL
  DELETE_NOTIFICATION
  DELETE_NOTIFICATION_ALL
  READ_NOTIFICATION_PREFERRED_TIME

  // === ONBOARDING ===
  READ_ONBOARDING
  UPDATE_ONBOARDING
}

enum Sender {
  user
  ai
}

enum QuestionType {
  multiple_choice
  fill_in_blank
  listening
  speaking
  writing
}

enum LearningStatus {
  new
  learning
  mastered
}

// Bảng Role đại diện cho 1 khối permission
model Role {
  id          Int          @id @default(autoincrement())
  name        String       @unique @db.VarChar(50) // "admin", "user"
  description String?      @db.VarChar(255)
  users       User[]
  permissions Permission[]
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @default(now()) @updatedAt @map("updated_at")

  @@map("roles")
}

// Bảng Permission lưu Enum trong DB, liên kết n-n với Role
model Permission {
  id          Int            @id @default(autoincrement())
  name        PermissionName @unique
  description String?        @db.VarChar(255)
  module      String         @db.VarChar(50)
  roles       Role[]
  createdAt   DateTime       @default(now()) @map("created_at")

  @@map("permissions")
}

// Nhóm tài khoản và hoạt động của chúng
model User {
  id            Int       @id @default(autoincrement())
  username      String    @unique @db.VarChar(50)
  email         String    @unique @db.VarChar(100)
  passwordHash  String    @map("password_hash") @db.VarChar(255)
  roleId        Int       @default(2) @map("role_id")
  role          Role      @relation(fields: [roleId], references: [id])
    job           String?   @db.VarChar(100)
    interests     String?   @db.Text
    avatarUrl     String?   @map("avatar_url") @db.Text
    cefrLevel     String?   @map("cefr_level") @db.VarChar(10)
    onboardingCompleted Boolean @default(false) @map("onboarding_completed")
  xpPoints      Int       @default(0) @map("xp_points")
  isLocked      Boolean   @default(false) @map("is_locked")
  //Bỏ last streak day vì sẽ tính từ lastlogin date thay vì lưu thông tin
  lastLoginDate DateTime? @map("last_login_date")
  createdAt     DateTime  @default(now()) @map("created_at")

  // Các mối quan hệ liên kết đến user
  refreshtokens       RefreshToken[]
  acctivitylogs       ActivityLog[]
  loginLogs           LoginLog[]
  aiChatSessions      AiChatSession[]
  userAchievements    UserAchievement[]
  userProgress        UserProgress[]
  userTestResults     UserTestResult[]
  revokedTokens       revoked_token[]
  assessmentHistories AssessmentHistory[]
  notifications       Notification[]
  communityPosts      CommunityPost[]
  postLikes           PostLike[]
  communityComments   CommunityComment[]

  // FAME-KT Multi-dimensional Assessment
  grammarElo      Int     @default(1200) @map("grammar_elo")
  vocabElo        Int     @default(1200) @map("vocab_elo")
  readingElo      Int     @default(1200) @map("reading_elo")
  listeningElo    Int     @default(1200) @map("listening_elo")
  preferredTopics String? @map("preferred_topics") @db.VarChar(255) // VD: "Technology,Travel"

    gameHistories GameHistory[]

  @@map("users")
}

model ActivityLog {
  id          Int      @id @default(autoincrement())
  userId      Int?     @map("user_id")
  actionType  String   @map("action_type") @db.VarChar(50)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("activity_logs")
}

model LoginLog {
  id         Int      @id @default(autoincrement())
  userId     Int      @map("user_id")
  ipAddress  String?  @map("ip_address") @db.VarChar(45)
  deviceInfo String?  @map("device_info") @db.Text
  loginTime  DateTime @default(now()) @map("login_time")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "user_id")
  @@map("login_logs")
}

model RefreshToken {
  id         Int      @id @default(autoincrement())
  userId     Int      @map("user_id")
  sessionId  String   @map("session_id") //ID đại diện cho từng thiết bị sẽ sinh ngẫu nhiên mỗi khi đăng nhập và giữ nguyên qua các lần refresh
  tokenHash  String   @unique @map("token_hash")
  deviceInfo String?  @map("device_info") @db.Text
  isRevoked  Boolean  @default(false)
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("refresh_tokens")
}

// Nhóm từ vựng và bài học (lesson)

model word {
  id              Int      @id @default(autoincrement())
  headword        String   @db.VarChar(100)
  partOfSpeech    String?  @map("part_of_speech") @db.VarChar(50)
  cefrLevel       String?  @map("cefr_level") @db.VarChar(10)
  phonetic        String?  @db.VarChar(100)
  audioUrl        String?  @map("audio_url") @db.Text
  imageUrl        String?  @map("image_url") @db.Text
  meaning         String?  @db.Text
  exampleSentence String?  @map("example_sentence") @db.Text
  createdAt       DateTime @default(now()) @map("created_at")
  deletedAt       DateTime? @map("deleted_at")

  lessonWords  LessonWord[]
  userProgress UserProgress[]

  @@index([headword], map: "idx_headword")
  @@index([cefrLevel], map: "idx_cefr_level")
  @@map("words")
}

model Topic {
  id          Int      @id @default(autoincrement())
  title       String   @db.VarChar(255)
  description String?  @db.Text
  cefrLevel   String?  @map("cefr_level") @db.VarChar(10)
  imageUrl    String?  @map("image_url") @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  deletedAt   DateTime? @map("deleted_at")

  lessons Lesson[]

  @@map("topic")
}

model Lesson {
  id           Int       @id @default(autoincrement())
  topicId      Int?      @map("topic_id")
  title        String    @db.VarChar(100)
  description  String?   @db.Text
  content      String?   @db.Text // Lý thuyết (Rich Text / HTML)
  videoUrl     String?   @map("video_url") @db.Text // Link Video bài giảng
  cefrLevel    String?   @map("cefr_level") @db.VarChar(10)
  thumbnailUrl String?   @map("thumbnail_url") @db.Text
  createdAt    DateTime  @default(now()) @map("created_at")
  deletedAt    DateTime? @map("deleted_at")

  topic       Topic?       @relation(fields: [topicId], references: [id], onDelete: SetNull)
  lessonWords LessonWord[]
  tests       Test[]

  @@index([topicId], map: "topic_id")
  @@map("lesson")
}

model LessonWord {
  lessonId Int @map("lesson_id")
  wordId   Int @map("word_id")

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  word   word   @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@id([lessonId, wordId])
  @@index([wordId], map: "word_id")
  @@map("lesson_word")
}

model UserProgress {
  id             Int            @id @default(autoincrement())
  userId         Int            @map("user_id")
  wordId         Int            @map("word_id")
  status         LearningStatus @default(new)
  memoryLevel    Int            @default(0) @map("memory_level")
  nextReviewDate DateTime?      @default(now()) @map("next_review_date")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @default(now()) @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  word word @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@unique([userId, wordId], map: "unique_user_word")
  @@index([wordId], map: "word_id")
  @@map("user_progress")
}

// Nhóm bài kiểm tra 
model Test {
  id          Int     @id @default(autoincrement())
  lessonId    Int?    @map("lesson_id")
  title       String  @db.VarChar(255)
  description String? @db.Text
  ceftLevel   String? @map("ceft_level") @db.VarChar(10)

  lesson           Lesson?          @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  questions        Question[]
  userTesstResults UserTestResult[]

  @@index([lessonId], map: "lesson_id")
  @@map("test")
}

model Question {
  id           Int          @id @default(autoincrement())
  testId       Int          @map("test_id")
  quesionText  String       @map("question_text") @db.Text
  questionType QuestionType @default(multiple_choice) @map("question_type")
  points       Decimal      @default(10)
  audioUrl     String?      @map("audio_url") @db.Text
  imageUrl     String?      @map("image_url") @db.Text

  test                Test                @relation(fields: [testId], references: [id], onDelete: Cascade)
  answers             Answer[]
  assessmentHistories AssessmentHistory[]


  // FAME-KT Assessment Data
  difficultyElo Int     @default(1200) @map("difficulty_elo")
  skillCategory String? @map("skill_category") @db.VarChar(50) // Grammar, Vocabulary, Reading
  topic         String? @db.VarChar(100)

  @@index([testId], map: "test_id")
  @@map("question")
}

model Answer {
  id         Int     @id @default(autoincrement())
  questionId Int     @map("question_id")
  answerText String  @map("answer_text") @db.Text
  isCorrect  Boolean @default(false) @map("is_correct")

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId], map: "question_id")
  @@map("answer")
}

model UserTestResult {
  id          Int      @id @default(autoincrement())
  userId      Int      @map("user_id")
  testId      Int      @map("test_id")
  totalScore  Decimal  @map("total_score")
  completedAt DateTime @default(now()) @map("completed_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  test Test @relation(fields: [testId], references: [id], onDelete: Cascade)

  @@index([userId], map: "user_id")
  @@index([testId], map: "test_id")
  @@map("user_test_result")
}

//Nhóm achievements
model Achievement {
  id            Int     @id @default(autoincrement())
  title         String  @db.VarChar(100)
  description   String? @db.Text
  iconUrl       String? @map("icon_url") @db.Text
  requireXp     Int     @default(0) @map("require_xp")
  requireStreak Int     @default(0) @map("require_streak")

  userAchievements UserAchievement[]

  @@map("achievement")
}

model UserAchievement {
  userId        Int         @map("user_id")
  achievementId Int         @map("achievement_id")
  unlockedAt    DateTime    @default(now()) @map("unlocked_at")
  user          User        @relation(fields: [userId], references: [id])
  achievement   Achievement @relation(fields: [achievementId], references: [id])

  @@id([userId, achievementId])
  @@index([achievementId], map: "achievement_id")
  @@map("user_achievement")
}

//Nhóm AI chat bot
model AiChatSession {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  title     String?   @default("New Conversation") @db.VarChar(255)
  startedAt DateTime  @default(now()) @map("started_at")

  user     User            @relation(fields: [userId], references: [id])
  messages AiChatMessage[]

  @@index([userId], map: "user_id")
  @@map("ai_chat_session")
}

model AiChatMessage {
  id          Int      @id @default(autoincrement())
  sessionId   Int      @map("session_id")
  sender      Sender
  messageText String   @map("message_text") @db.Text
  createdAt   DateTime @default(now()) @map("created_at")

  aiChatSession AiChatSession @relation(fields: [sessionId], references: [id])

  @@index([sessionId], map: "session_id")
  @@map("ai_chat_message")
}

model revoked_token {
  access_token_hash String   @id @db.VarChar(255)
  revoked_at        DateTime @default(now())
  description       String   @db.Text
  user_id           Int

  user User @relation(fields: [user_id], references: [id])

  @@map("revoked_token")
}

// ==========================================
// GAME MANAGEMENT
// ==========================================

model Game {
  id          Int           @id @default(autoincrement())
  name        String
  code        String        @unique // e.g. MEMORY, MATCHING, BUBBLE
  description String?       @db.Text
  isActive    Boolean       @default(true)
  settings    GameSetting[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GameSetting {
  id            Int    @id @default(autoincrement())
  gameId        Int
  difficulty    String // EASY, NORMAL, HARD
  itemCount     Int // Số lượng từ (VD: 6, 10, 15)
  pointsPerItem Int
  penaltyPoints Int           @default(0) // Điểm mỗi câu đúng
  timeLimit     Int? // Giới hạn thời gian (giây) - nullable

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([gameId, difficulty])
}

// Lịch sử Đánh giá Thích ứng (FAME-KT Test History)
model AssessmentHistory {
  id          Int      @id @default(autoincrement())
  userId      Int      @map("user_id")
  questionId  Int      @map("question_id")
  isCorrect   Boolean  @map("is_correct")
  timeTakenMs Int      @map("time_taken_ms")
  userAnswer  String?  @db.Text @map("user_answer")
  avgEloAfter Int      @map("avg_elo_after")
  createdAt   DateTime @default(now()) @map("created_at")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([userId], map: "user_id")
  @@index([questionId], map: "question_id")
  @@map("assessment_history")
}

model CommunityPost {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  content   String   @db.Text
  imageUrl  String?  @map("image_url") @db.Text
  isPublic  Boolean  @default(true) @map("is_public")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  postLikes PostLike[]
  comments  CommunityComment[]
  images    PostImage[]

  @@index([userId], map: "user_id")
  @@map("community_post")
}

model PostImage {
  id        Int           @id @default(autoincrement())
  postId    Int           @map("post_id")
  imageUrl  String        @map("image_url") @db.Text
  createdAt DateTime      @default(now()) @map("created_at")

  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId], map: "post_id")
  @@map("post_images")
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  title     String   @db.VarChar(255)
  body      String   @db.Text
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId], map: "user_id")
  @@map("notification")
}

model PostLike {
  id        Int      @id @default(autoincrement())
  postId    Int      @map("post_id")
  userId    Int      @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@map("post_like")
}

model CommunityComment {
  id        Int      @id @default(autoincrement())
  postId    Int      @map("post_id")
  userId    Int      @map("user_id")
  content   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("community_comment")
}

model GameHistory {
  id           Int      @id @default(autoincrement())
  userId       Int      @map("user_id")
  gameCode     String   @map("game_code") @db.VarChar(50)
  score        Int      @default(0)
  durationSec  Int      @default(0) @map("duration_sec")
  correctPairs Int      @default(0) @map("correct_pairs")
  totalPairs   Int      @default(0) @map("total_pairs")
  createdAt    DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("game_history")
}
